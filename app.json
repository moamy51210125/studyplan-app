{
  "expo": {
    "name": "できたカレンダー",
    "slug": "studyplan-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "studyplanapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.moamy.dekitacalendar"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FEF694",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.moamy.dekitacalendar",
      "versionCode": 1
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEF694",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5d579d13-d6dd-4410-b26b-c46ce88b9d33"
      }
    }
  }
}
